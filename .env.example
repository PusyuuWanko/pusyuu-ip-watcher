# IP Watcher configuration
# v4.2: 監視ドメインとサーバー状態APIのURLは dns_targets.json で指定します。
#   監視ドメイン   → xserver.domains の auto_update=true なAレコードすべて
#   サーバー状態API → "server_status": {"url": "..."}
# 以下の SERVER_STATUS_URL は dns_targets.json に url が無い場合の予備値です。
SERVER_STATUS_URL=https://pusyuuwanko.com/server_status
CHECK_INTERVAL_SECONDS=60

# Web画面(管理画面)の待ち受けアドレスとポート。起動スクリプトはこの値で起動します。
#   127.0.0.1 … このPCからだけ開ける(初期値・推奨)
#   0.0.0.0   … 同じLAN内の他の端末(スマホ等)からも開ける。画面に認証は無いので、
#               信頼できるネットワーク内だけで使い、ルーターでポート開放はしないこと。
# 8000番が他のアプリと衝突する場合は WATCHER_PORT を変えてください(例: 8080)。
WATCHER_HOST=127.0.0.1
WATCHER_PORT=8000

# XServer Domain API
# The API key is kept here, not in dns_targets.json.
XSERVER_API_KEY=
XSERVER_MIN_SYNC_INTERVAL_SECONDS=300

# MyDNS.JP HTTP-BASIC notification (optional)
MYDNS_USERNAME=
MYDNS_PASSWORD=
MYDNS_IPV4_URL=https://ipv4.mydns.jp/login.html
# MyDNSへのIP通知間隔。86400 = 24時間。
MYDNS_NOTIFY_INTERVAL_SECONDS=86400

# v3 compatibility:
# If dns_targets.json does not exist, these old settings are migrated once.
# After migration, edit dns_targets.json instead.
XSERVER_ENABLED=false
XSERVER_DOMAIN=pusyuuwanko.com
XSERVER_DNS_HOSTS=@
